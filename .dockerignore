# Build context is the repo root, since the image builds the frontend and the
# backend in one multi-stage build.

**/.venv/
**/__pycache__/
**/*.pyc
**/.env
**/node_modules/
**/dist/

backend/storage/
backend/cv_spike/output/
backend/cv_spike/sample_videos/
