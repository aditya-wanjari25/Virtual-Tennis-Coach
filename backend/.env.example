ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
DATABASE_URL=postgresql+psycopg://tennis:tennis@localhost:5432/tennis_coach

# Browser origins allowed to call this API, comma-separated.
# MUST include the deployed frontend's origin or every request fails CORS.
CORS_ORIGINS=http://localhost:5173

# How long uploaded videos are kept. They're retained after analysis so chat
# can re-watch a swing; this bounds the growth. Swept at startup.
VIDEO_RETENTION_DAYS=7

# --- Input guardrails ---------------------------------------------------
# Generous against real phone footage (the cv_spike samples run 5-47s,
# 1.5-11MB, 162-1407 frames); these bound abuse and cost, not normal use.
MAX_UPLOAD_MB=100
MAX_VIDEO_DURATION_S=90
# The one that matters most: pose extraction runs one MediaPipe inference per
# frame on CPU, so frame count bounds both CPU burn and how long a user waits.
MAX_VIDEO_FRAMES=3000
MAX_VIDEO_LONG_EDGE_PX=3840
# Ceiling on a chat message, so a scripted request can't run up a token bill.
MAX_CHAT_CHARS=2000
