ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
DATABASE_URL=postgresql+psycopg://tennis:tennis@localhost:5432/tennis_coach

# Browser origins allowed to call this API, comma-separated.
# MUST include the deployed frontend's origin or every request fails CORS.
CORS_ORIGINS=http://localhost:5173

# How long uploaded videos are kept. They're retained after analysis so chat
# can re-watch a swing; this bounds the growth. Swept at startup.
VIDEO_RETENTION_DAYS=7
